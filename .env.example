# copy to .env and fill in the blanks -- .env is gitignored, never commit it

# MySQL the scraped articles are written to -- required by scrape.py
SCRAPER_DB_HOST=
SCRAPER_DB_PORT=3306
SCRAPER_DB_USER=
SCRAPER_DB_PASSWORD=
SCRAPER_TNS_DB=

# required by build_recipes.py, which asks the model for a site's selectors
ANTHROPIC_API_KEY=
# optional, these are the defaults
SCRAPER_LLM_MODEL=claude-haiku-4-5
SCRAPER_LLM_WORKSPACE_ID=
