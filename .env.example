# copy to .env and fill in the blanks -- .env is gitignored, never commit it

# MySQL the scraped articles are written to -- required by scrape.py
SCRAPER_DB_HOST=
SCRAPER_DB_PORT=3306
SCRAPER_DB_USER=
SCRAPER_DB_PASSWORD=
SCRAPER_TNS_DB=
# the agencies column holding the lede template -- defaults to lead when unset
SCRAPER_LEDE_COLUMN=

# required by build_recipes.py, which asks the model for a site's selectors
ANTHROPIC_API_KEY=
# optional, these are the defaults
SCRAPER_LLM_MODEL=claude-haiku-4-5
SCRAPER_LLM_WORKSPACE_ID=

# only read with scrape.py --production, which emails the run summary
SCRAPER_MAIL_HOST=
SCRAPER_MAIL_PORT=587
SCRAPER_MAIL_USER=
SCRAPER_MAIL_PASSWORD=
SCRAPER_MAIL_FROM=
# several addresses separate on a comma or a semicolon
SCRAPER_MAIL_TO=
SCRAPER_MAIL_CC=

# 1 runs Chrome with no window, the same as passing --headless
SCRAPER_HEADLESS=
