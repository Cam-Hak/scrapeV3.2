.env
.venv/
__pycache__/
.pytest_cache/

# production dumps, local only -- db/press_releases.sql is the schema and is kept
db/*.dmp.sql

# the old scraper, kept for reference -- its configs carry live db credentials
original_scrape.zip
scrape_prototype/

# run-log artifacts from the verification checklist
baseline.txt
after.txt

# chrome crash dumps and seleniumbase download artifacts
core.*
downloaded_files/

# run output -- logs and the per-run history are local to the machine that ran it
*.log
runs.jsonl
run_sites.jsonl
